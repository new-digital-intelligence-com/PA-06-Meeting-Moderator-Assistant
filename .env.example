# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Live replies and note-taking: fast wins.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# The minutes and the follow-up email, written once, off the clock.
ANTHROPIC_MODEL_WRITER=claude-sonnet-5

# ---- Recall.ai (gets her into the Google Meet) ----
# https://www.recall.ai — the first 5 recording hours are free.
RECALL_API_KEY=
# Your account's region: us-west-2, us-east-1, eu-central-1, ap-northeast-1.
RECALL_REGION=eu-central-1
# Recall's own transcription is the default: Google Meet's captions depend on CC being
# switched on, mislabel the bot's own voice, and were observed to stop arriving mid
# meeting. Set to "meeting_captions" to use Meet's instead.
RECALL_TRANSCRIPT_PROVIDER=
# The name in her participant tile.
BOT_NAME=Ava — Moderator

# ---- Her own Google account (optional) ----
# Without this she joins as a guest named BOT_NAME and somebody has to let her in.
# With it she joins as a real Google account — its own name and photo — and walks
# straight in when her address is on the invite. Needs a separate Google Workspace
# with SAML SSO; the README has the steps. This is the login group id from Recall.
RECALL_GOOGLE_LOGIN_GROUP_ID=

# ---- Ava in person: her own Chrome, signed in as her ----
# Shared secret between this app and the runner in bot/. The runner can read her
# calendar, mark her as attending and send notes as her; this key is what stops a
# stranger who finds the URL doing the same. Same value in bot/.env and in Vercel.
AVA_RUNNER_KEY=
# Her Google address. "Connect Ava's Google" refuses any other account.
AVA_EMAIL=ava@your-company.com

# ---- The public address of THIS app ----
# Recall's browser loads PUBLIC_URL/bot over the internet and streams it into the call
# as her camera, so localhost gives you a bot with a blank tile. In development:
#   cloudflared tunnel --url http://localhost:3000
# then paste the https address it prints here and restart.
PUBLIC_URL=

# ---- Where the meeting is stored ----
# Local dev needs none of this: it falls back to data/meeting.json.
#
# On Vercel you MUST set one of them. Serverless instances do not share a filesystem
# or a process, so without an external store the stage and the control room end up
# looking at two different meetings.
#
# Either Redis (Vercel KV / Upstash — best fit: HTTP, no pooling, no cold-start
# handshake). Adding the Upstash integration from the Vercel dashboard sets these for
# you automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# ...or MongoDB, if you already have a cluster and would rather not add a service:
MONGODB_URI=
MONGODB_DB=meeting_moderator

# ---- Anam (her face AND her voice, on one stream) ----
# lab.anam.ai -> API key. Replaces the old Simli + ElevenLabs pair: Anam renders the
# face and speaks the words together, so there is no PCM to ship between two services
# and nothing to keep in sync by hand.
ANAM_API_KEY=
# The persona you built in Anam Lab. Its avatar and voice are read from here; its own
# LLM is deliberately NOT used — the moderator's words come from this app.
ANAM_PERSONA_ID=
# Optional: set these two instead of a persona id to skip the lookup.
ANAM_AVATAR_ID=
ANAM_VOICE_ID=


# ---- Google OAuth (ava@new-digital-intelligence.com) ----
# Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
APP_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Clients (the portal: /admin for NDI, /client for each client) ----
# Supabase — the team's shared "pocs" project, reached through its Data API. All of hers
# is in her own schema: run db/schema.sql once in the SQL editor, then Project Settings ->
# Data API -> Exposed schemas -> add pa-06. The secret key is for the server only.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SCHEMA=pa-06
SUPABASE_SERVICE_ROLE_KEY=
# Turns each passage of a client's documents into a vector, so she can search them by
# meaning. Only embeddings are requested: nothing is stored at OpenAI.
OPENAI_API_KEY=
# Optional. text-embedding-3-large also fits (it is shortened to the same 1536 numbers).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The Drive folder clients' files are kept in, one folder per client. Its ID is the end
# of its link. Ava's Google account must be an Editor of it. Never "Anyone with the link".
CLIENTS_DRIVE_FOLDER=
# Who is an admin: everyone with an address on this domain.
ADMIN_DOMAIN=new-digital-intelligence.com

# ---- Google's file picker ("From Google Drive" on a client's page) ----
# Cloud Console, same project as the OAuth client: enable the Google Picker API and the
# Google Drive API; create an API key restricted to those and to this site's address;
# add this site to the OAuth client's "Authorized JavaScript origins"; add the drive.file
# scope to the consent screen. The app ID is the project NUMBER (Cloud Console home).
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
