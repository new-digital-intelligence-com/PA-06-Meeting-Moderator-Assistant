# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Live replies and note-taking: fast wins.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# The minutes and the follow-up email, written once, off the clock.
ANTHROPIC_MODEL_WRITER=claude-sonnet-5

# ---- Recall.ai (gets her into the Google Meet) ----
# https://www.recall.ai — the first 5 recording hours are free.
RECALL_API_KEY=
# Your account's region: us-west-2, us-east-1, eu-central-1, ap-northeast-1.
RECALL_REGION=us-west-2
# "meeting_captions" (default) uses Google Meet's own captions: free, and already
# labelled with real speaker names. Set to "recallai" for Recall's paid transcription.
RECALL_TRANSCRIPT_PROVIDER=meeting_captions
# The name in her participant tile.
BOT_NAME=Ava — Moderator

# ---- The public address of THIS app ----
# Recall's browser loads PUBLIC_URL/bot over the internet and streams it into the call
# as her camera, so localhost gives you a bot with a blank tile. In development:
#   cloudflared tunnel --url http://localhost:3000
# then paste the https address it prints here and restart.
PUBLIC_URL=

# ---- Where the meeting is stored ----
# Local dev needs none of this: it falls back to data/meeting.json.
#
# On Vercel you MUST set one of them. Serverless instances do not share a filesystem
# or a process, so without an external store the stage and the control room end up
# looking at two different meetings.
#
# Either Redis (Vercel KV / Upstash — best fit: HTTP, no pooling, no cold-start
# handshake). Adding the Upstash integration from the Vercel dashboard sets these for
# you automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# ...or MongoDB, if you already have a cluster and would rather not add a service:
MONGODB_URI=
MONGODB_DB=meeting_moderator

# ---- ElevenLabs (her voice) ----
ELEVENLABS_API_KEY=
# Default: Bella. Free accounts cannot use Voice Library voices via the API (402).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- Simli (her face) ----
# app.simli.com -> API key, then Create Avatar for a face ID.
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_MAX_SESSION=7200
SIMLI_MAX_IDLE=3600

# ---- Google OAuth (ava@new-digital-intelligence.com) ----
# Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
APP_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
