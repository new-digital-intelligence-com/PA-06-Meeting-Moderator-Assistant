# The deployed app — her brain and memory.
AVA_APP_URL=https://your-app.vercel.app

# Must match AVA_RUNNER_KEY in the app's environment (Vercel).
AVA_RUNNER_KEY=

# Protects the web view of her screen, which is a signed-in Google account. Long and random:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
AVA_ADMIN_PASSWORD=

# How many seconds before the start time she opens the meeting.
AVA_JOIN_EARLY_SECONDS=60

# Her screen online over HTTPS (optional; otherwise only through an SSH tunnel). Needs
# ports 80 and 443 open to the server. AVA_SCREEN_HOST is a name pointing at the server:
# for the IP 1.2.3.4 the free 1-2-3-4.sslip.io works, or a subdomain of your own.
# COMPOSE_PROFILES=public
# AVA_SCREEN_HOST=1-2-3-4.sslip.io

# Her name when she joins Teams as a guest (sent from the control room).
AVA_DISPLAY_NAME=Ava

# Participants that are bots, not people, when she counts who is in the call — on top of
# the notetakers she already knows (Fireflies, Otter, Read.ai, Fathom, tl;dv…). Comma-separated.
AVA_IGNORE_PARTICIPANTS=

# voice (default) or avatar — avatar adds her Anam face, lip-synced to the same voice
AVA_MODE=voice
# Her voice. The model (eleven_flash_v2_5) speaks English, German and Arabic; the same
# voice is used for all three unless a voice of its own is set per language.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_ID_DE=
# ELEVENLABS_VOICE_ID_AR=

# Who hears and speaks for her: claude (default) — Meet/Teams captions, Claude on the app,
# ElevenLabs voice — or live: OpenAI GPT-Live hears the meeting's sound and holds the
# conversation, full duplex, handing what needs her memory of the meeting to Claude.
# Captions still make the transcript and the notes.
AVA_BRAIN=claude
# For AVA_BRAIN=live (platform.openai.com → API keys).
OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1
# Fixed for a session: alloy, ash, ballad, beacon, bossa, cedar, cinder, coral, delta,
# echo, gleam, marin, meridian, quartz, ripple, sage, shimmer, stone, tempo, verse,
# vesper, willow.
# OPENAI_VOICE=gleam
# Who answers what GPT-Live hands over (earlier decisions, a recap, noting an action,
# current facts): an OpenAI model run by OpenAI — gpt-6-luna (fast), gpt-6-sol (stronger)
# — with web search and the meeting's record, or "claude" (through the app, no web).
# OPENAI_DELEGATION_MODEL=gpt-6-luna
# How hard that OpenAI model thinks: none, minimal, low, medium, high, xhigh.
# OPENAI_DELEGATION_EFFORT=low

# Which Arabic Meet's captions listen for: "Arabic (Maghrebi)" (default), "Arabic (Egypt)",
# "Arabic (Levant)", "Arabic (Peninsular Gulf)" or "Arabic (United Arab Emirates)".
# AVA_ARABIC_CAPTIONS=Arabic (Maghrebi)

# Avatar mode: her face, from lab.anam.ai. With these two she asks Anam herself; without
# them the app (Vercel) asks for her with its own ANAM_API_KEY.
ANAM_API_KEY=
ANAM_AVATAR_ID=
# Anam cuts each session off after a time set by your plan (Free 180,
# Starter 300, Explorer 600, Growth 7200 seconds); she renews it before then.
ANAM_SESSION_SECONDS=180
# The rate GPT-Live's voice is sent to the face at: 16000 (default — filtered down from
# 24 kHz, where Anam's lip-sync is proven) or 24000 (untouched).
# ANAM_PCM_RATE=16000
# Anam bills by the minute, so her face rests after this many quiet seconds and shows a
# clip of her at rest until somebody talks to her again.
AVA_FACE_IDLE_SECONDS=45
