# The deployed app — her brain and memory.
AVA_APP_URL=https://your-app.vercel.app

# Must match AVA_RUNNER_KEY in the app's environment (Vercel).
AVA_RUNNER_KEY=

# Protects the web view of her screen, which is a signed-in Google account. Long and random:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
AVA_ADMIN_PASSWORD=

# How many seconds before the start time she opens the meeting.
AVA_JOIN_EARLY_SECONDS=60

# Her name when she joins Teams as a guest (sent from the control room).
AVA_DISPLAY_NAME=Ava

# Participants that are bots, not people, when she counts who is in the call — on top of
# the notetakers she already knows (Fireflies, Otter, Read.ai, Fathom, tl;dv…). Comma-separated.
AVA_IGNORE_PARTICIPANTS=

# voice (default) or avatar — avatar adds her Anam face, lip-synced to the same voice
AVA_MODE=voice
# Her voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Avatar mode: her face, from lab.anam.ai. With these two she asks Anam herself; without
# them the app (Vercel) asks for her with its own ANAM_API_KEY.
ANAM_API_KEY=
ANAM_AVATAR_ID=
# Anam cuts each session off after a time set by your plan (Free 180,
# Starter 300, Explorer 600, Growth 7200 seconds); she renews it before then.
ANAM_SESSION_SECONDS=180
# Anam bills by the minute, so her face rests after this many quiet seconds and shows a
# clip of her at rest until somebody talks to her again.
AVA_FACE_IDLE_SECONDS=45
